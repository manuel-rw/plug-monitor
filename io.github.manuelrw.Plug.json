{
    "app-id": "io.github.manuelrw.Plug",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "plug",
    "finish-args": [
        "--device=all",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "modules": [
        {
            "name": "plug",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/manuel-rw/plug-monitor.git",
                    "tag": "v0.1.0",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/manuel-rw/plug-monitor/releases/latest",
                        "version-query": "tag_name",
                        "tag-query": "tag_name"
                    }
                }
            ]
        }
    ]
}
