<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>org.gnome.USBTesterMonitor</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <name>USB Tester Monitor</name>
    <summary>Monitor USB tester devices</summary>
    <description>
        <p>USB Tester Monitor is a GNOME application for monitoring USB tester devices 
        like the Qianli iBridge A3. It provides real-time voltage and current readings, 
        data visualization, and logging capabilities.</p>
        
        <p>Features:</p>
        <ul>
            <li>Real-time voltage and current monitoring</li>
            <li>Support for multiple USB tester devices</li>
            <li>Data visualization with charts</li>
            <li>Logging and data export</li>
            <li>GNOME 50 and Adwaita design</li>
        </ul>
    </description>
    <url type="homepage">https://github.com/Creased/Qianli-iBridge-A3-Monitor</url>
    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/Creased/Qianli-iBridge-A3-Monitor/main/demo.png</image>
            <caption>Desktop Monitor</caption>
        </screenshot>
    </screenshots>
    <releases>
        <release version="@version@" date="2024-01-01">
            <description>
                <p>Initial release with support for Qianli iBridge A3.</p>
            </description>
        </release>
    </releases>
</component>
